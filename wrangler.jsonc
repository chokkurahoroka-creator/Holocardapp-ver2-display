{
  "name": "holocardapp-ver2",
  // Worker：「/api/decklog」を処理する（静的ファイルの配信は、これまでどおり）
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    // Worker から、静的ファイルを返すときに使う
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 「/api/」で始まるアクセスだけ、先に Worker を通す（それ以外は、Worker を通さず、静的ファイルをそのまま配信）
    "run_worker_first": ["/api/*"]
  },
  // 公開しても問題のない値です（サイトに、すでに、含まれているもの）。.env の VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY と、同じ値を入れてください
  "vars": {
    "SUPABASE_URL": "https://pgazbkpavsfmtfaaoglw.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_nkceGPB8GT7N5MYImwjaUA_Y--x0VJm"
  }
}
